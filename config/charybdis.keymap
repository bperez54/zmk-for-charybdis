/{ 
    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&lt 3 Q     &kp W           &kp F           &kp P               &kp G       &kp J   &kp L               &kp U           &kp Y       &kp SEMI
&kp A       &hml LALT R     &hml LCTRL S    &hml LEFT_SHIFT T   &kp D       &kp H   &hmr LEFT_SHIFT N   &hmr LCTRL E    &hmr RALT I &kp O
&mt LC(Z) Z &mt LC(X) X     &mt LC(C) C     &mt LC(V) V         &mt LC(B) B &kp K   &kp M               &kp COMMA       &kp DOT     &mt LS(FSLH) ESC
                &mkp MB1  &mkp MB2  &lt 1 ENTER    &bspc_del  &lt 2 SPACE
            >;
        };

        layer_1 {
            bindings = <
&kp TAB     &tdsqt          &kp DQT     &kp LPAR  &kp RPAR  &none       &mt LS(N7) N7  &mt LS(N8) N8  &mt LS(N9) N9  &kp MINUS
&kp FSLH    &kp BACKSLASH   &kp LBRC    &kp RBRC  &kp LBKT  &kt RBKT    &mt LS(N4) N4  &mt LS(N5) N5  &mt LS(N6) N6  &kp EQUAL     
&kp LCTRL   &kp LEFT_ALT    &kp DEL     &kp CAPS  &kp LGUI  &none       &mt LS(N1) N1  &mt LS(N2) N2  &mt LS(N3) N3  &kp DOT  
                           &none         &none     &none      &none    &kp N0
            >;
        };

        layer_2 {
            bindings = <
&none       &none            &kp UP_ARROW    &none              &none   &kp F1  &kp F2  &kp F3  &kp F4  &kp F5
&none       &kp LEFT_ARROW   &kp DOWN_ARROW  &kp RIGHT_ARROW    &none   &kp F6  &kp F7  &kp F8  &kp F9  &kp F10       
&kp HOME    &kp END         &kp PAGE_UP  &kp PAGE_DOWN          &none   &kp F11 &kp F12 &none   &none   &none 
                       &none           &none            &none            &none      &none
            >;
        };

        layer_3 {
            bindings = <
&none  &none  &none  &none  &none    &none       &none         &none         &none         &none
&rgb_ug RGB_TOG  &none  &none  &none  &none    &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3
&none  &none  &none  &none  &none    &none       &none         &none         &none         &none
              &none  &none  &none    &none       &none
            >;
        };

        /* layer_2 {
            bindings = <
